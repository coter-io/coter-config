# ─── OpenRouter ───────────────────────────────────────────────────────────────
# openrouter.ai/keys → Create Key (used for all chat, vision, PDF and image models)
OPENROUTER_API_KEY=

# ─── Anthropic ────────────────────────────────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# platform.openai.com/api-keys
# Required: audio transcription calls OpenAI directly (tools.media.models in
# config/openclaw.json uses gpt-4o-transcribe-mini), so the stack will not start
# without it. Chat models all route through OpenRouter.
OPENAI_API_KEY=

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Telegram @BotFather → /newbot
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id — the only account allowed to DM the bot and run
# commands (config/openclaw.json allowlists it). Get it from @userinfobot.
TELEGRAM_USER_ID=

# ─── OpenClaw Gateway ─────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# ─── Directories ──────────────────────────────────────────────────────────────
OPENCLAW_CONFIG_DIR=/home/openclaw/.openclaw
OPENCLAW_WORKSPACE_DIR=/home/openclaw/.openclaw/workspace

# ─── GitHub ───────────────────────────────────────────────────────────────────
# github.com/settings/tokens → Fine-grained or Classic PAT
# Scopes needed: repo, workflow, read:org (for the github skill: PRs, issues, CI)
GH_TOKEN=

# ─── Brave Search ─────────────────────────────────────────────────────────────
# brave.com/search/api (free tier)
# Optional. OpenClaw auto-detects a search provider from the API keys present,
# so the name must match what docker-compose.yml injects.
BRAVE_API_KEY=

# ─── Composio (MCP tool server) ───────────────────────────────────────────────
# app.composio.dev → your MCP server's connection URL and API key.
# Wired up as mcp.servers.composio in config/openclaw.json.
COMPOSIO_MCP_URL=
COMPOSIO_API_KEY=

# ─── GHCR (GitHub Container Registry) ─────────────────────────────────────────
# Your GitHub username for pulling Docker images
GHCR_USERNAME=

# ─── Workspace Git Sync (optional) ──────────────────────────────────────────
# Daily commit+push of ~/.openclaw/workspace to a private remote git repository.
# Use one of the following options to enable:

# 1. Remote github repository in the format 'username/repo'
# Create a PAT at: https://github.com/settings/tokens with 'repo' scope
# Auto-enables when GIT_WORKSPACE_REPO is set; redeploy to apply
# Example:
# - Repo Reference: your-username/openclaw-workspace
GIT_WORKSPACE_REPO=
GIT_WORKSPACE_TOKEN=

# 2. other private git hosting, e.g. GitLab, Bitbucket,...
# Search how to create an inline authentication url for the provider
# Examples:
# - GitLab = https://user:token@gitlab.com/.../<repo_name>.git
# - Bitbucket = https://x-token-auth:token@bitbucket.org/.../<repo_name>.git
GIT_WORKSPACE_REMOTE=

# Configure also the branch name and cron schedule 
GIT_WORKSPACE_BRANCH=auto
# Cron schedule: minute hour day month weekday (default: daily at 4 AM UTC)
GIT_WORKSPACE_SYNC_SCHEDULE=0 4 * * *

# For multi-agent setups, add per-agent repos (see docker-compose.yml):
# GIT_WORKSPACE_REPO_SECOND=your-username/openclaw-workspace-second
# or
# GIT_WORKSPACE_REMOTE_SECOND=https://user:token@gitlab.com/username/repo-second.git
