{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "controlUi": {
      "allowedOrigins": ["http://localhost:18789"]
    }
  },

  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "allowlist",
      "allowFrom": ["tg:${TELEGRAM_USER_ID}"],
      "groupPolicy": "disabled",
      "streaming": {
        "mode": "partial",
        "chunkMode": "newline",
        "preview": {
          "toolProgress": true
        }
      }
    }
  },

  "env": {
    "vars": {
      "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}"
    }
  },

  "models": {
    "providers": {
      "openrouter": {
        "params": {
          "provider": {
            "data_collection": "deny",
            "require_parameters": true
          }
        }
      }
    }
  },

  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      }
    }
  },

  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/anthropic/claude-haiku-5.5",
        "fallbacks": [
          "openrouter/openai/gpt-6.1-terra",
          "openrouter/google/gemini-3.6-flash"
        ]
      },
      "utilityModel": "openrouter/qwen/qwen3.7-flash",
      "imageModel": {
        "primary": "openrouter/qwen/qwen3.8-flash",
        "fallbacks": ["openrouter/google/gemini-3.1-flash-lite"]
      },
      "pdfModel": {
        "primary": "openrouter/google/gemini-3.1-flash-lite",
        "fallbacks": ["openrouter/anthropic/claude-haiku-5.5"]
      },
      "mediaModels": {
        "image": {
          "primary": "openrouter/google/gemini-3.1-flash-image",
          "fallbacks": ["openrouter/google/gemini-3.1-flash-lite-image"]
        }
      },
      "models": {
        "openrouter/anthropic/claude-sonnet-5.5": { "alias": "sonnet" },
        "openrouter/openai/gpt-6.1-terra": { "alias": "terra" }
      },
      "modelPolicy": {
        "allow": [
          "openrouter/anthropic/claude-haiku-5.5",
          "openrouter/openai/gpt-6.1-terra",
          "openrouter/google/gemini-3.6-flash",
          "openrouter/anthropic/claude-sonnet-5.5"
        ]
      },
      "compaction": {
        "mode": "safeguard"
      },
      "maxConcurrent": 2,
      "subagents": {
        "maxConcurrent": 4
      }
    },
    "entries": {
      "main": {
        "identity": {
          "name": "Coter",
          "emoji": "🔘"
        }
      }
    }
  },

  "commands": {
    "native": false,
    "nativeSkills": "auto",
    "allowFrom": {
      "telegram": ["tg:${TELEGRAM_USER_ID}"]
    }
  },

  "tools": {
    "media": {
      "models": [
        {
          "type": "provider",
          "provider": "openrouter",
          "model": "openai/whisper-large-v3-turbo",
          "capabilities": ["audio"]
        },
        {
          "type": "provider",
          "provider": "openrouter",
          "model": "openai/gpt-4o-mini-transcribe",
          "capabilities": ["audio"]
        }
      ],
      "audio": {
        "enabled": true
      }
    }
  },

  "mcp": {
    "servers": {
      "composio": {
        "transport": "streamable-http",
        "url": "${COMPOSIO_MCP_URL}",
        "headers": {
          "x-api-key": "${COMPOSIO_API_KEY}"
        }
      }
    }
  },

  "logging": {
    "level": "info",
    "consoleLevel": "info"
  }
}
